# Example environment variables for legal_rag_engine
# Copy to `.env` for local runs, or set the same names in your host's secret manager
# (Streamlit Cloud "Secrets", Docker Compose `environment:`, GitHub Actions secrets, etc).
# Do NOT commit a real .env file — only this example is tracked in git.

# ---- Runtime (device selection for local inference) ----
RUNTIME_DEVICE=auto            # auto | cpu | cuda
RUNTIME_GPU_ID=0
RUNTIME_PRECISION=auto

# ---- Retrieval ----
DENSE_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
FAISS_INDEX_PATH=artifacts/indexes/dense_faiss.index
EMBEDDINGS_CACHE=artifacts/embeddings/embeddings_cache.json

# ---- Generation / LLM backend ----
# One of: qwen_transformers | openai_compatible
LLM_BACKEND=qwen_transformers
QWEN_OFFLOAD_DIR=artifacts/qwen_offload

# Used only when LLM_BACKEND=openai_compatible (also used directly by the
# Streamlit UI's OpenAI/Gemini provider selectors)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=

# ---- App / API ----
ARTIFACT_DIR=artifacts
LOG_LEVEL=INFO
API_KEY=replace-with-a-strong-random-value
LEGAL_API_URL=http://localhost:8000/v1/query

# ---- DVC remote ----
# Local relative paths only work on the machine that created them.
# Use real cloud storage for anything shared across CI/teammates.
DVC_REMOTE_URL=gs://your-bucket/legal-rag-artifacts

# ---- Monitoring (optional, off by default) ----
PROMETHEUS_ENABLED=false
OTEL_COLLECTOR_URL=
MLFLOW_TRACKING_URI=
SENTRY_DSN=
LOGFLARE_SOURCE_TOKEN=

# ---- Streamlit Cloud local-runtime guard ----
# Keep at 0 on Streamlit Cloud / any host without a GPU and without torch/faiss installed.
ALLOW_LOCAL_MODEL_RUNTIME=0
